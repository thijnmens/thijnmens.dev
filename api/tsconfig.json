{
	"compilerOptions": {
		"noImplicitAny": false,
		"noEmit": true,
		"removeComments": true,
		"sourceMap": true,
		"target": "es2020",
		"outDir": "dist",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"module": "nodeNext",
		"moduleResolution": "nodeNext",
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*"]
}
